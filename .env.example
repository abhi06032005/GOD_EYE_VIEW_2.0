# SentinelAI Environment Configuration

# Ingestion Mode: 'live' or 'replay'
INGEST_MODE=replay

# Message Broker (Redpanda / Kafka API)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=sentinelai

# Relational & Geospatial Store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret

# Vector Store (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=events

# LLM & RAG Provider: 'openai' | 'ollama' | 'none'
LLM_PROVIDER=none
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# External API Keys (Optional - fallbacks active when unset)
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
CESIUM_ION_TOKEN=

# Computer Vision
YOLO_MODEL=yolov8n.pt
CV_CONF_THRESHOLD=0.35
CV_FPS_TARGET=5

# API & Gateway
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
